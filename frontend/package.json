{
  "name": "personal-website-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node mock-server/server.js",
    "build": "tsc -b && vite build",
    "photos:assets": "node scripts/photo-pipeline.mjs assets",
    "photos:seed": "node scripts/photo-pipeline.mjs seed",
    "photos:all": "node scripts/photo-pipeline.mjs all",
    "preview": "vite preview",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.0.20",
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "express": "^4.21.0",
    "globals": "^16.5.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.1.3"
  },
  "engines": {
    "node": "^22.14.0 || >=24.0.0"
  }
}
